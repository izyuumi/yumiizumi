---
import "@/styles/color.scss";
import "@/styles/global.scss";
import Footer from "@/components/Footer.astro";
import Head from "@/components/Head.astro";

interface Props {
  title: string;
  description: string;
  slug?: string;
  isNotBlog?: boolean;
  image?: string;
}

const { title, description, slug, isNotBlog = false, image } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head
      title={title}
      description={description}
      slug={slug}
      isBlog={!isNotBlog}
      image={image}
    />
  </head>
  <body>
    <header class="blog-header">
      <a href="/">Yumi Izumi</a>
      <a href="/blog">Writing</a>
    </header>
	<main id="main">
      <slot />
    </main>
    <Footer />
    <style lang="scss" is:global>
      html {
        font-family: sans-serif;
        min-height: 100svh;
        font-size: large;
        line-height: 1.8;
        color: var(--text-color);
        background-color: var(--bg-color);
        display: flex;
        align-items: center;
        flex-direction: column;
      }
      body {
        display: flex;
        flex-direction: column;
        min-height: 100svh;
        width: var(--content-width);
        padding-top: max(60px, env(safe-area-inset-top));
        padding-bottom: env(safe-area-inset-bottom);
      }
      main {
        flex: 1;
      }
      a,
      a:visited {
        color: var(--text-color);
      }
      a:focus {
        outline: 2px solid var(--text-hover-color);
        outline-offset: 2px;
        color: var(--text-hover-color);
      }
      .blog-header {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.5rem;
        a {
          text-decoration: none;
        }
      }
      article {
        h1 {
          font-size: 2.5rem;
          font-weight: bold;
          margin-top: 1rem;
          margin-bottom: 0.8rem;
          line-height: 1.2;
        }
        h2,
        h3,
        h4,
        h5,
        h6 {
          margin-top: 1rem;
          margin-bottom: 0.5rem;
          line-height: 1.2;
        }
        ul {
          margin-left: 1em;
        }
        code {
          background-color: rgba(var(--text-color-rgb), 0.1);
          padding: 0.1em 0.3em;
        }
        img {
          max-width: 100%;
          height: auto;
        }
        p {
          margin-bottom: 1.2rem;
        }
      }
      @media screen and (max-width: 768px) {
        body {
          width: 100%;
          padding: max(1rem, env(safe-area-inset-top))
            max(var(--mobile-margin), env(safe-area-inset-right))
            max(1rem, env(safe-area-inset-bottom))
            max(var(--mobile-margin), env(safe-area-inset-left));
        }
      }
      @media (hover: hover) and (pointer: fine) {
        a:hover {
          color: var(--text-hover-color);
        }
      }
    </style>
  </body>
</html>
