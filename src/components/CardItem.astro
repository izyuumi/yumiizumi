---
interface Props {
  title: string;
  badge?: string;
  meta: string;
  href?: string;
  onclick?: string;
  subtle?: boolean;
  description?: string;
}

const { title, badge, meta, href, onclick, subtle, description } = Astro.props;
---

<li class:list={["card", { "card-subtle": subtle }]}>
  {href ? (
    <a href={href}>
      <span class="card-title">{title}</span>
      <span class="card-badges">
        {badge && <span class="badge">{badge}</span>}
      </span>
      <span class="card-meta">{meta}</span>
      {description && <span class="card-description">{description}</span>}
    </a>
  ) : (
    <button class="card-button" onclick={onclick}>
      <span class="card-title">{title}</span>
      <span class="card-badges">
        {badge && <span class="badge">{badge}</span>}
      </span>
      <span class="card-meta">{meta}</span>
      {description && <span class="card-description">{description}</span>}
    </button>
  )}
</li>

<style>
  .card-badges {
    display: flex;
    gap: 0.4rem;
    align-items: center;
  }
  .card-description {
    grid-column: 1 / -1;
    color: var(--muted);
    font-size: 0.9em;
  }
</style>
