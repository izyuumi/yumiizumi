---
import SiteLayout from "@/layouts/SiteLayout.astro";
import Home from "@/components/Home.astro";
import { en } from "@/data/home";

const langLinks = [
  { href: "/", label: "English", hrefLang: "en" },
  { href: "/ja", label: "日本語", hrefLang: "ja" },
];
---

<SiteLayout
  title={en.title}
  description={en.description}
  lang="en"
  themeLabels={en.theme}
  langLinks={langLinks}
>
  <Home copy={en} />
  <script is:inline>
    // The old homepage carried these sections; they now live on /about.
    // Fixed list, one hop, no-JS visitors still reach them via the "about" link.
    {
      const id = location.hash.slice(1);
      if (
        ["about", "experience", "projects", "skills", "stack", "contact"].includes(
          id,
        )
      )
        location.replace("/about#" + id);
    }
  </script>
</SiteLayout>
