---
import BusinessCard from "@/components/BusinessCard.astro";
import Head from "@/components/Head.astro";
---

<html lang="en">
  <head>
    <Head
      title="Yumi Izumi's Virtual Business Card"
      description="Yumi Izumi's Virtual Business Card"
      image="https://yumiizumi.com/assets/business-card.png"
    />
  </head>
  <body>
    <div id="container">
      <BusinessCard />
    </div>
    <div id="info">
      <p>
        Last updated: {
          new Date().toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
          })
        }
      </p>
      <p>
        <a href="https://yumiizumi.com/">See my portfolio</a>
      </p>
    </div>
    <style lang="scss">
      html {
        font-family: "Inter", sans-serif;
        min-height: 100svh;
        background-color: #161616;
      }
      body {
        min-height: 100svh;
        margin: 0;
        padding:
          env(safe-area-inset-top)
          env(safe-area-inset-right)
          env(safe-area-inset-bottom)
          env(safe-area-inset-left);
        box-sizing: border-box;
      }
      #container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: calc(
          100svh - env(safe-area-inset-top) - env(safe-area-inset-bottom)
        );
        width: 100%;
      }
      #info {
        display: flex;
        flex-direction: column;
        align-items: center;
        position: fixed;
        right: 50%;
        bottom: max(2em, env(safe-area-inset-bottom));
        transform: translateX(50%);
        color: #e2e2e2;
        p {
          margin: 5px;
        }
        a,
        a:visited {
          color: inherit;
        }
        a:focus-visible {
          outline: 2px solid #5a8eff;
          outline-offset: 3px;
          color: #5a8eff;
        }
      }
      @media (hover: hover) and (pointer: fine) {
        #info a:hover {
          color: #5a8eff;
        }
      }
    </style>
  </body>
</html>
